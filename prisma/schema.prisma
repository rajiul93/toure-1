// Day Tour Paris — PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Image {
  id         String       @id @default(cuid())
  key        String       @unique
  url        String
  filename   String
  mimeType   String
  size       Int
  alt        String?
  uploadedBy String?
  usages     ImageUsage[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([createdAt])
}

model ImageUsage {
  id         String   @id @default(cuid())
  imageId    String
  image      Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  field      String   @default("default")
  createdAt  DateTime @default(now())

  @@unique([imageId, entityType, entityId, field])
  @@index([entityType, entityId])
  @@index([imageId])
}

enum PublishStatus {
  DRAFT
  PUBLISH
}

model Blog {
  id                String        @id @default(cuid())
  blogDate          DateTime      @db.Date
  publishDate       DateTime      @db.Date
  publishStatus     PublishStatus @default(DRAFT)
  isDeleted         Boolean       @default(false)
  authorId          String
  tags              String[]
  keywords          String[]
  categoryId        String
  countryId         String
  title             String
  slug              String        @unique
  shortDescription  String
  description       String        @db.Text
  featuredImageUrl  String        @default("")
  featuredImageAlt  String        @default("")
  galleryImages     Json          @default("[]")
  isFeatured        Boolean       @default(false)
  metaTitle         String
  metaDescription   String
  metaImageUrl      String        @default("")
  metaImageAlt      String        @default("")
  fbMetaTitle       String        @default("")
  fbMetaDescription String        @default("")
  fbMetaImageUrl    String        @default("")
  fbMetaImageAlt    String        @default("")
  faqs              BlogFaq[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([publishDate])
  @@index([publishStatus])
  @@index([isDeleted])
  @@index([createdAt])
}

model BlogFaq {
  id        String @id @default(cuid())
  blogId    String
  blog      Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  question  String
  answer    String @db.Text
  sortOrder Int    @default(0)

  @@index([blogId])
}

model SiteSettings {
  id        String   @id @default("default")
  data      Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model TourSettings {
  id        String   @id @default("default")
  data      Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model SeoSettings {
  id        String   @id @default("default")
  data      Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// A tour/experience rendered at /attraction-tours/[slug].
/// List-shaped sections are JSON columns (same approach as Blog.galleryImages);
/// reviews are relational because they are edited and ordered individually.
model AttractionTour {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  isPublished Boolean @default(false)
  isDeleted   Boolean @default(false)

  ratingAverage Float @default(0)
  reviewCount   Int   @default(0)

  priceFrom        String
  priceNote        String   @default("")
  primaryCta       String   @default("Check availability")
  secondaryOptions String[] @default([])

  /// Quill-authored HTML, sanitized on save.
  overviewDescription String @db.Text
  highlightsHtml      String @default("") @db.Text

  lovedTags   String[] @default([])
  lovedQuotes String[] @default([])

  /// Quill-authored HTML, sanitized on save.
  meetingPointAddress  String @default("") @db.Text
  questionsDescription String @default("")
  questionsCtaLabel    String @default("Contact us")
  questionsCtaHref     String @default("/about-us")

  /// [{ id, url, alt, label, featured }] — hero collage + full gallery
  galleryPhotos  Json @default("[]")
  /// [{ id, title, items: string[] }] — inclusion / exclusion / know-before-you-go
  /// [{ id, title, html }] — `html` is Quill-authored, sanitized on save.
  importantInfo  Json @default("[]")
  /// [{ url, alt }]
  travelerPhotos Json @default("[]")

  /// SEO + social. Every field falls back to the tour's own content when blank,
  /// so a tour is never required to fill these in.
  metaTitle       String   @default("")
  metaDescription String   @default("") @db.Text
  metaKeywords    String[] @default([])
  ogImageUrl      String   @default("")
  ogImageAlt      String   @default("")

  /// Per-tour Bokun widget. Blank means "use the site-wide channel/experience
  /// from /admin/site-config", which is what the home page uses.
  bokunChannel      String @default("")
  bokunExperienceId String @default("")

  reviews AttractionTourReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([isDeleted])
  @@index([createdAt])
}

model AttractionTourReview {
  id         String         @id @default(cuid())
  tourId     String
  tour       AttractionTour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  reviewer   String
  /// Display string such as "Jul 2026" — matches the existing reviews data.
  reviewDate String
  rating     Int
  text       String         @db.Text
  sortOrder  Int            @default(0)

  @@index([tourId])
}

enum KnowledgeBaseCategory {
  GENERAL
  HOURS
  TICKETS
  BOOKING
  TRAVEL
  VISITOR_INFO
  RULES
  FAQ
  OTHER
}

model KnowledgeBaseEntry {
  id          String                @id @default(cuid())
  tourSlug    String?
  category    KnowledgeBaseCategory @default(GENERAL)
  question    String
  answer      String                @db.Text
  isPublished Boolean               @default(true)
  isDeleted   Boolean               @default(false)
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([isPublished])
  @@index([isDeleted])
  @@index([tourSlug])
  @@index([category])
  @@index([createdAt])
}

model UnansweredQuestion {
  id              String   @id @default(cuid())
  question        String   @db.Text
  tourSlug        String?
  isResolved      Boolean  @default(false)
  resolvedEntryId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isResolved])
  @@index([createdAt])
}

model AiSettings {
  id        String   @id @default("default")
  data      Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AiUsageLog {
  id               String   @id @default(cuid())
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  status           String
  question         String   @db.Text
  tourSlug         String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([provider])
}
